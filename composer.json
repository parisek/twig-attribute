{
    "name": "parisek/twig-attribute",
    "description": "A Twig extension for adding attributes to an element",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "twig",
        "attribute"
    ],
    "homepage": "https://github.com/parisek/twig-attribute",
    "require": {
        "php": "^8.3",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\Component\\Attribute\\": "src",
            "Parisek\\Twig\\": "",
            "Parisek\\Twig\\Internal\\": "src/Internal"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Parisek\\Twig\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    }
}
